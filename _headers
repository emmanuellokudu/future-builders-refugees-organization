# Netlify / Static Host Cache Headers

# Static assets with hashing or immutable content: 1 year cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# CSS and JS: 1 hour cache with revalidation
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# HTML pages: always revalidate for instant updates
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Web manifest & sitemap
/site.webmanifest
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
